---
/**
 * CommandTabs — the terminal card, plus a link out to the deployment guides.
 *
 * This used to be two tabs, both carrying a pasteable command. It is now one
 * tab and one link, and the reasoning is recorded on QUICKSTART in copy.ts: the
 * Docker one-liner in the second tab did not work, and a paste that fails is
 * worse than a click that leaves.
 *
 * The link is deliberately NOT `role="tab"`. It sits in the same strip and
 * shares the type, but it carries an arrow, underlines on hover, and is an
 * anchor — so it reads as somewhere to go rather than something to open. A real
 * tab that navigates is the thing worth avoiding; a link that looks like a link
 * is not that.
 */
import Icon from './Icon.astro';
import { QUICKSTART, DEPLOY_LINK } from './copy';

interface Props {
	/** Tab ids must be unique per page: this card renders twice. */
	idPrefix: string;
	class?: string;
}
const { idPrefix, class: className } = Astro.props;
---

<div class={`tabs ${className ?? ''}`} data-tabs>
	<div class="strip">
		<div class="tablist" role="tablist" aria-label="Ways to install Paddock">
			<button
				type="button"
				role="tab"
				id={`${idPrefix}-tab-${QUICKSTART.id}`}
				aria-controls={`${idPrefix}-panel-${QUICKSTART.id}`}
				aria-selected="true"
				tabindex="0"
			>
				{QUICKSTART.label}
			</button>
		</div>
		<a class="deploy" href={DEPLOY_LINK.href} title={DEPLOY_LINK.title}>
			{DEPLOY_LINK.label} <span aria-hidden="true">→</span>
		</a>
	</div>

	<div
		role="tabpanel"
		id={`${idPrefix}-panel-${QUICKSTART.id}`}
		aria-labelledby={`${idPrefix}-tab-${QUICKSTART.id}`}
		tabindex="0"
	>
		<div class="term">
			<div class="term-bar">
				<span class="dot dot--r" />
				<span class="dot dot--y" />
				<span class="dot dot--g" />
				<button type="button" class="copy" data-copy={QUICKSTART.command}>
					<Icon name="copy" class="i-copy" />
					<Icon name="check" class="i-check" />
					<span class="copy-label">Copy</span>
				</button>
			</div>
			<pre class="term-body"><code><span class="prompt">$</span> {QUICKSTART.command}</code></pre>
		</div>
		<p class="blurb">
			{QUICKSTART.blurb}{' '}
			<a href={QUICKSTART.link.href}>
				{QUICKSTART.link.text} <span aria-hidden="true">→</span>
			</a>
		</p>
	</div>
</div>

<style>
	.tabs {
		width: 100%;
		min-width: 0;
	}

	/* Tab and link share one row, baseline-aligned, so the strip still reads as
	   one control even though only the left half is a tab. */
	.strip {
		display: flex;
		align-items: stretch;
		gap: 0.25rem;
	}

	.tablist {
		display: flex;
		gap: 0.25rem;
	}

	/*
	 * Styled as a LINK, not a second tab. It shares the type scale and padding so
	 * the row lines up, but it never takes the selected tab's background, it
	 * carries an arrow, and it underlines on hover — the three things that say
	 * "this goes somewhere" rather than "this opens a panel".
	 */
	.deploy {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.55rem 1rem;
		font-size: 0.88rem;
		font-weight: 500;
		color: var(--text-subtle);
		text-decoration: none;
		border-radius: 9px 9px 0 0;
		transition: color 0.15s ease;
	}

	.deploy:hover {
		color: rgb(var(--accent));
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.deploy span {
		transition: transform 0.15s ease;
	}

	.deploy:hover span {
		transform: translateX(2px);
	}

	@media (prefers-reduced-motion: reduce) {
		.deploy span {
			transition: none;
		}
	}

	.tablist button {
		appearance: none;
		border: 0;
		background: transparent;
		color: var(--text-subtle);
		font: inherit;
		font-size: 0.88rem;
		font-weight: 500;
		padding: 0.55rem 1rem;
		border-radius: 9px 9px 0 0;
		cursor: pointer;
		transition:
			color 0.15s ease,
			background-color 0.15s ease;
	}

	.tablist button:hover {
		color: var(--text);
	}

	.tablist button[aria-selected='true'] {
		color: var(--text);
		background: color-mix(in oklab, var(--sunken) 88%, transparent);
	}

	.term {
		background: color-mix(in oklab, var(--sunken) 92%, transparent);
		border: 1px solid var(--border-subtle);
		border-radius: 0 12px 12px 12px;
		backdrop-filter: blur(12px);
		overflow: hidden;
	}

	.term-bar {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.6rem 0.75rem;
		border-bottom: 1px solid color-mix(in oklab, var(--border-subtle) 70%, transparent);
	}

	.dot {
		width: 11px;
		height: 11px;
		border-radius: 50%;
		flex: none;
	}
	.dot--r {
		background: #ef5f56;
	}
	.dot--y {
		background: #f5bd4f;
	}
	.dot--g {
		background: #61c554;
	}

	.copy {
		margin-inline-start: auto;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		background: transparent;
		border: 0;
		color: var(--text-subtle);
		font: inherit;
		font-size: 0.78rem;
		cursor: pointer;
		padding: 0.25rem 0.4rem;
		border-radius: 6px;
		transition: color 0.15s ease;
	}

	.copy:hover {
		color: var(--text);
	}

	.copy :global(svg) {
		width: 14px;
		height: 14px;
	}

	/* Two icons, one swapped for the other by state, so the button does not
	   change width when it flips to "Copied". */
	.copy :global(.i-check) {
		display: none;
	}
	.copy[data-state='ok'] {
		color: #7fd06f;
	}
	.copy[data-state='ok'] :global(.i-check) {
		display: block;
	}
	.copy[data-state='ok'] :global(.i-copy) {
		display: none;
	}
	.copy[data-state='error'] {
		color: #ef8b7f;
	}

	.copy[data-state='ok'] .copy-label::after {
		content: 'ied';
	}
	.copy[data-state='error'] .copy-label {
		font-size: 0;
	}
	.copy[data-state='error'] .copy-label::after {
		content: 'Press ⌘C';
		font-size: 0.78rem;
	}

	.term-body {
		margin: 0;
		padding: 1rem 1.1rem 1.15rem;
		font-family: var(--font-mono);
		font-size: 0.86rem;
		line-height: 1.65;
		color: var(--text);
		overflow-x: auto;
		white-space: pre-wrap;
		word-break: break-word;
	}

	.prompt {
		color: rgb(var(--accent));
		user-select: none;
		margin-inline-end: 0.35rem;
	}

	.blurb {
		margin: 0.9rem 0 0;
		font-size: 0.86rem;
		line-height: 1.6;
		color: var(--text-subtle);
	}

	.blurb a {
		color: var(--text-muted);
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-color: color-mix(in oklab, var(--text-muted) 45%, transparent);
		white-space: nowrap;
	}

	.blurb a:hover {
		color: rgb(var(--accent));
	}
</style>
